# Frontend → Backend
# Leave empty to use Vite proxy at /api-proxy → https://localhost:7137
# Or set a direct URL (requires CORS AllowedOrigins on the API):
# VITE_API_BASE_URL=https://localhost:7137
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://localhost:7137

# Optional (AI Studio / Gemini features)
GEMINI_API_KEY=
APP_URL=
